# Determine the location of the script to locate parcel
# Reference: http://stackoverflow.com/questions/59895/can-a-bash-script-tell-what-directory-its-stored-in
SOURCE="${BASH_SOURCE[0]}"
BIN_DIR="$(dirname "$SOURCE")"
while [ -h "$SOURCE" ]
do
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
  BIN_DIR="$( cd -P "$( dirname "$SOURCE"  )" && pwd )"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

# Populate necessary environment variables
source $BIN_DIR/env.sh


if [ "$#" -ne 2 ]; then
  echo "Usage: $0 branch pipeline " >&2
  exit 1
fi

ensure_kerberos_auth

branch=$1
pipeline=$2

if [ ! -d "$pipeline" ]; then
    echo "pipeline $pipeline does not exist"
    exit 1
fi

generated_dir=generated/$pipeline/ondemand
mkdir -p "$generated_dir"
generated_ondemand_props=$generated_dir/ondemand.properties
echo "# GENERATED FILE - EDITS WILL BE OVERWRITTEN - EDIT ondemand.properties.template instead." > "$generated_ondemand_props"
sed -e s/BRANCH/$branch/g $pipeline/ondemand/ondemand.properties.template >> "$generated_ondemand_props"
job_name=${branch}.${pipeline}.ondemand

ship_configs=()
local_hive_conf_dir="hive-conf"
if [ -d "$local_hive_conf_dir" ]; then
    ship_configs+=("-y" "$local_hive_conf_dir")
    echo "hive.confdir=$local_hive_conf_dir" >> "$generated_ondemand_props"
fi

classpath_options=()
classpath_config "-c" "iceberg-flink-runtime"

# The job reads a bounded set of log events, so it is restarted from scratch rather than from a savepoint.
cs-start-job -j flink-enrichment-ondemand -p /etc/cybersec/conf/triage.properties -p kafka.properties -p "$generated_ondemand_props" "${ship_configs[@]}"  "${classpath_options[@]}"

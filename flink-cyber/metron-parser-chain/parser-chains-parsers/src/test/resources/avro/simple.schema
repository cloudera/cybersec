{"type":"record","name":"SimpleUser","namespace":"com.example.user","doc":"A simplified record for user information.","fields":[{"name":"userId","type":"long","doc":"Unique identifier for the user"},{"name":"username","type":"string","doc":"Display name of the user"},{"name":"email","type":"string","doc":"User's primary email address"},{"name":"isActive","type":["null","boolean"],"default":null,"doc":"Status of the user account"},{"name":"age","type":["null","int"],"default":null,"doc":"Age of the user"}]}